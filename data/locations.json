    "knowledge": [
      {
        "title": "主祀神明",
        "text": "臺中文昌廟以文昌帝君為主神，與地方重視讀書、教育的文化有關。",
        "source": "https://taiwangods.moi.gov.tw/Religious_Culture/html/Cultural/3_0011.aspx?i=68"
      },
      {
        "title": "社學與教育",
        "text": "文昌廟曾開辦社學，提供地方居民讀書、識字的機會，兼有教育功能。",
        "source": "https://taiwangods.moi.gov.tw/Religious_Culture/html/Cultural/3_0011.aspx?i=68"
      },
      {
        "title": "文化資產",
        "text": "臺中文昌廟是直轄市定古蹟，保存具有歷史、文化與藝術價值的寺廟建築。",
        "source": "https://taiwangods.moi.gov.tw/Religious_Culture/html/Cultural/3_0011.aspx?i=68"
      },
      {
        "title": "建廟歷史",
        "text": "文昌廟現址於清同治年間興建，1871 年竣工，屬於清領時期的建築。",
        "source": "https://taiwangods.moi.gov.tw/Religious_Culture/html/Cultural/3_0011.aspx?i=68"
      }
    ]
